# Database (PostgreSQL) — préférez DATABASE_URL en local et en Docker
DATABASE_URL=postgresql://together:together@localhost:5433/together

# Alternative sans URL (utilisées seulement si DATABASE_URL est absent)
# PGHOST=localhost
# PGPORT=5433
# PGUSER=together
# PGPASSWORD=together
# PGDATABASE=together

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d

# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Node environment
NODE_ENV=development

# Config SMTP (utiliser = pour les variables d'environnement)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=nice-user@smtp.example.com
SMTP_PASS=password
SMTP_SECURE=tls
SMTP_FROM=user-website
SMTP_FROM_NAME=From company name
